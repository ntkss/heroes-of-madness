# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files that must always use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
