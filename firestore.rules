rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'nattakit.suksaeng@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    // Players
    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Matches
    match /matches/{matchId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'underdogMvp']));
      allow delete: if isAdmin();

      // Comments
      match /comments/{commentId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Seasons
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sensitive config (LINE system) restricted to Admin
    match /config/lineSystem {
      allow read, write: if isAdmin();
    }

    // Public config (ranks, badges, seasonConfig)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Match Images (Enforce max size < 1MB to prevent document overflow)
    match /matchImages/{matchId} {
      allow read: if true;
      allow write: if request.resource.data.image is string && request.resource.data.image.size() < 1000000;
    }

    // Config Bootstrap
    match /config/bootstrap {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    !exists(/databases/$(database)/documents/config/bootstrap) && 
                    request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'user' || (
          request.resource.data.role == 'admin' && (
            request.auth.token.email == 'nattakit.suksaeng@gmail.com' ||
            existsAfter(/databases/$(database)/documents/config/bootstrap)
          )
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Posts & Comments
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'dislikes', 'userVotes'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }
    }
  }
}
